#rr-document.rr-bottom-dock #rr-panel.management-family-panel > .panel-head .panel-title,
#rr-document.rr-bottom-dock #rr-panel.management-family-panel > .rr-shell .rr-shell-content > .panel-head .panel-title,
#rr-document.rr-bottom-dock #rr-panel.decision-family-panel > .panel-head .panel-title,
#rr-document.rr-bottom-dock #rr-panel.decision-family-panel > .rr-shell .rr-shell-content > .panel-head .panel-title,
#rr-document.rr-bottom-dock #rr-panel.selection-family-panel > .panel-head .panel-title,
#rr-document.rr-bottom-dock #rr-panel.selection-family-panel > .rr-shell .rr-shell-content > .panel-head .panel-title,
#rr-document.rr-bottom-dock #rr-panel.live-hud-family-panel > .panel-head .panel-title,
#rr-document.rr-bottom-dock #rr-panel.live-hud-family-panel > .rr-shell .rr-shell-content > .panel-head .panel-title{
    flex: 0 0 190px;
    width: 190px;
}
#rr-document.rr-bottom-dock #rr-panel.management-family-panel > .panel-head .panel-title h1,
#rr-document.rr-bottom-dock #rr-panel.management-family-panel > .rr-shell .rr-shell-content > .panel-head .panel-title h1,
#rr-document.rr-bottom-dock #rr-panel.decision-family-panel > .panel-head .panel-title h1,
#rr-document.rr-bottom-dock #rr-panel.decision-family-panel > .rr-shell .rr-shell-content > .panel-head .panel-title h1,
#rr-document.rr-bottom-dock #rr-panel.selection-family-panel > .panel-head .panel-title h1,
#rr-document.rr-bottom-dock #rr-panel.selection-family-panel > .rr-shell .rr-shell-content > .panel-head .panel-title h1,
#rr-document.rr-bottom-dock #rr-panel.live-hud-family-panel > .panel-head .panel-title h1,
