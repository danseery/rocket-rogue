    overflow-y: var(--rr-legacy-layout-117, hidden);
    padding-right: var(--rr-legacy-layout-118, 0px);
}
#rr-modal.modal-launch_introduction .modal-scroll-body,
#rr-modal.modal-approach_introduction .modal-scroll-body,
