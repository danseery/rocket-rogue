}
#rr-document.rr-bottom-dock #rr-panel.management-family-panel > .panel-head .panel-head-actions button,
#rr-document.rr-bottom-dock #rr-panel.management-family-panel > .rr-shell .rr-shell-content > .panel-head .panel-head-actions button,
#rr-document.rr-bottom-dock #rr-panel.decision-family-panel > .panel-head .panel-head-actions button,
#rr-document.rr-bottom-dock #rr-panel.decision-family-panel > .rr-shell .rr-shell-content > .panel-head .panel-head-actions button,
#rr-document.rr-bottom-dock #rr-panel.selection-family-panel > .panel-head .panel-head-actions button,
#rr-document.rr-bottom-dock #rr-panel.selection-family-panel > .rr-shell .rr-shell-content > .panel-head .panel-head-actions button,
#rr-document.rr-bottom-dock #rr-panel.live-hud-family-panel > .panel-head .panel-head-actions button,
#rr-document.rr-bottom-dock #rr-panel.live-hud-family-panel > .rr-shell .rr-shell-content > .panel-head .panel-head-actions button{
