/* rr-bundle:
tokens.rcss
primitives.rcss
shells.rcss
families.rcss
screen-exceptions.rcss
legacy.rcss
*/

/* Shared visual and geometry tokens. Runtime code may override inherited
   variables on #rr-document for viewport-specific metrics. */
body {
	--rr-phase-board-width: 736px;
	--rr-phase-content-width: 704px;
	--rr-phase-lane-inset: 16px;
	--rr-workspace-max-width: 1200px;
	--rr-workspace-inset: 24px;
	--rr-workspace-action-stack-height: 504px;
	--rr-card-gap: 10px;
	--rr-control-height: 38px;
	--rr-modal-gutter: 24px;

	--rr-color-void: #02090d;
	--rr-color-panel: #07151c;
	--rr-color-panel-raised: #0b202a;
	--rr-color-line: #244b5c;
	--rr-color-line-strong: #3f7286;
	--rr-color-text: #c7d2d9;
	--rr-color-muted: #78909c;
	--rr-color-signal: #1bc9dc;
	--rr-color-objective: #d2ad45;
	--rr-color-ready: #46c587;
	--rr-color-danger: #e36868;
}

/* Reusable, parameterized component lanes. Dynamic content stays in the
   typed C++ renderers; these classes own their shared geometry. */
.rr-screen-header,
.rr-objective-strip,
.rr-metric-strip,
.rr-fixed-lane-card,
.rr-detail-stack,
.rr-action-footer,
.rr-fixed-action-stack,
.rr-fixed-action-context,
.rr-fixed-action-lane {
	box-sizing: border-box;
	width: 100%;
}

.rr-objective-strip,
.rr-fixed-lane-card {
	border-width: 1px;
	border-color: var(--rr-color-line);
	background-color: var(--rr-color-panel);
}

.rr-objective-strip,
.rr-fixed-lane-card {
	padding: 12px;
}

.rr-screen-header {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	border-bottom-width: 1px;
	border-color: var(--rr-color-line);
}

.rr-objective-strip {
	color: var(--rr-color-text);
}

.rr-objective-strip.active {
	border-color: var(--rr-color-objective);
}

.rr-objective-strip.locked {
	border-color: var(--rr-color-line);
}

.rr-objective-strip.ready-to-claim,
.rr-objective-strip.complete {
	border-color: var(--rr-color-ready);
}

.rr-metric-strip,
.rr-card-grid,
.rr-action-footer {
	display: flex;
	flex-direction: row;
	gap: var(--rr-card-gap);
}

.rr-metric-strip,
.rr-card-grid {
	flex-wrap: wrap;
}

.rr-action-footer {
	min-height: 54px;
	padding: 8px;
	align-items: center;
	justify-content: flex-end;
	border-top-width: 1px;
	border-color: var(--rr-color-line);
}

.rr-detail-stack {
	display: flex;
	flex-direction: column;
	gap: var(--rr-card-gap);
}

.rr-fixed-lane-card {
	min-height: 96px;
}

/* A reusable decision workspace keeps its variable context scrollable while
   preserving the final choice lane inside the viewport. This is the shared
   geometry for Surface Ops today and future card-based workspaces that need a
   persistent final action row. */
.rr-fixed-action-stack {
	display: flex;
	flex-direction: column;
	height: var(--rr-workspace-action-stack-height);
	min-height: 280px;
	overflow: hidden;
	padding-bottom: 0px;
}

.rr-fixed-action-context {
	display: block;
	flex: 1 1 auto;
	min-height: 0px;
	overflow-x: hidden;
	overflow-y: auto;
}

.rr-fixed-action-lane {
	display: flex;
	flex: 0 0 auto;
	min-height: 0px;
	margin-top: 8px;
	overflow: hidden;
}

/* Persistent document hosts and the small set of screen geometries. */
.rr-document {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 100%;
	color: var(--rr-color-text);
	background-color: transparent;
}

.rr-panel,
.rr-screen-host,
.rr-shell,
.rr-shell-content {
	box-sizing: border-box;
	width: 100%;
	height: 100%;
}

.rr-scene-overlay-host,
.rr-modal-host,
.rr-controller-prompt-host,
.rr-performance-host {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 100%;
	pointer-events: none;
}

.rr-scene-overlay-host {
	z-index: 10;
}

#rr-scene-launch-control,
#rr-scene-launch-control * {
	pointer-events: auto;
}

.rr-modal-host {
	z-index: 30;
}

.rr-controller-prompt-host {
	z-index: 40;
}

.rr-performance-host {
	z-index: 50;
}

.rr-shell {
	display: flex;
	flex-direction: column;
	align-items: center;
}

.rr-shell-lane {
	box-sizing: border-box;
	width: var(--rr-phase-board-width);
	max-width: 100%;
	height: 100%;
	margin-left: auto;
	margin-right: auto;
	padding-left: var(--rr-phase-lane-inset);
	padding-right: var(--rr-phase-lane-inset);
}

.rr-shell-lane > .rr-shell-content {
	width: var(--rr-phase-content-width);
	max-width: 100%;
}

/* Desktop Hangar content is deliberately a compact planning board. Keep its
   fixed 736px frame centered in the full viewport instead of leaving a large
   empty field to the right and below it. Other shells retain their full-height
   lane for long or scrollable workspaces. */
.rr-shell.rr-family-hangar {
	justify-content: center;
}

.rr-shell.rr-family-hangar > .rr-shell-lane,
.rr-shell.rr-family-hangar > .rr-shell-lane > .rr-shell-content {
	height: auto;
}

.rr-workspace-lane {
	width: var(--rr-workspace-max-width);
	padding-left: var(--rr-workspace-inset);
	padding-right: var(--rr-workspace-inset);
}

.rr-workspace-lane > .rr-shell-content {
	width: 100%;
}

/* Some first-wave migrated payloads still own their authored viewport padding
   and lane width. Only their explicit compatibility class may neutralize the
   template lane, avoiding a second inset without changing future shells. */
#rr-panel > .rr-shell.rr-legacy-content-owns-lane > .rr-shell-lane {
	width: 100%;
	max-width: none;
	margin-left: 0px;
	margin-right: 0px;
	padding-left: 0px;
	padding-right: 0px;
}

#rr-panel > .rr-shell.rr-legacy-content-owns-lane > .rr-shell-lane > .rr-shell-content {
	width: 100%;
	max-width: none;
}

.rr-control-shell,
.rr-surface-minigame-shell,
.rr-mining-shell {
	background-color: transparent;
}

.rr-mining-content {
	flex: 1;
}

.rr-modal-layer {
	position: absolute;
	left: 0px;
	top: 0px;
	width: 100%;
	height: 100%;
	display: block;
	padding: 0px;
	box-sizing: border-box;
	pointer-events: auto;
	background-color: transparent;
}

.rr-modal-surface {
	box-sizing: border-box;
	width: 100%;
	height: 100%;
	max-width: none;
	max-height: none;
	padding: 0px;
	overflow: visible;
	border-width: 0px;
	background-color: transparent;
}

/* Visual-family hooks. Screens select a family explicitly in presentation
   metadata instead of inferring it from generated markup. */
.rr-family-management {
	--rr-family-accent: var(--rr-color-signal);
}

.rr-family-decision {
	--rr-family-accent: var(--rr-color-objective);
}

.rr-family-live-hud {
	--rr-family-accent: var(--rr-color-signal);
}

.rr-family-surface-minigame {
	--rr-family-accent: var(--rr-color-ready);
}

.rr-family-hangar {
	--rr-family-accent: var(--rr-color-signal);
}

.rr-family-navigation {
	--rr-family-accent: #53a7d8;
}

.rr-family-research {
	--rr-family-accent: #9d7fd3;
}

.rr-family-arrival {
	--rr-family-accent: var(--rr-color-ready);
}

.rr-family-selection {
	--rr-family-accent: var(--rr-color-objective);
}

.rr-family-drone-ops {
	--rr-family-accent: #47a995;
}

.rr-family-mining {
	--rr-family-accent: #aab6bd;
}

.rr-family-results {
	--rr-family-accent: var(--rr-color-objective);
}

.rr-shell[class*="rr-family-"] .rr-screen-header {
	border-color: var(--rr-family-accent);
}

/* Screen-specific exceptions belong here only when a shared shell or primitive
   cannot express the geometry. Keep this layer intentionally small. */
.rr-takeover-shell .rr-shell-lane,
.rr-results-shell .rr-shell-lane {
	padding-top: 24px;
	padding-bottom: 24px;
}

.rr-control-shell .rr-control-lane,
.rr-surface-minigame-shell .rr-surface-minigame-lane {
	padding-top: 8px;
	padding-bottom: 8px;
}

/* First-wave screens still bring their proven viewport-height geometry with
   them. Until their dynamic renderers are converted component by component,
   the template wrapper must not shift or clip that content vertically. */
#rr-panel > .rr-takeover-shell .rr-shell-lane,
#rr-panel > .rr-results-shell .rr-shell-lane,
#rr-panel > .rr-control-shell .rr-control-lane,
#rr-panel > .rr-surface-minigame-shell .rr-surface-minigame-lane {
	padding-top: 0px;
	padding-bottom: 0px;
}

body {
    position: absolute;
    left: 0px;
    top: 0px;
    width: var(--rr-legacy-layout-001, 0px);
    height: var(--rr-legacy-layout-002, 0px);
    overflow: hidden;
    color: #edf4f8;
    font-family: source-code-pro;
    font-size: 14px;
}
div,
p,
h1,
h2,
h3,
aside {
    display: block;
}
span,
strong,
small {
    display: block;
}
scrollbarvertical {
    display: block;
    width: 10px;
    background-color: #0b1118;
    border-width: 0px;
}
scrollbarvertical slidertrack {
    display: block;
    width: 10px;
    background-color: #111c26;
}
scrollbarvertical sliderbar {
    display: block;
    width: 8px;
    min-height: 30px;
    margin-left: 1px;
    background-color: #4e6b80;
    border-radius: 4px;
}
scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc,
scrollbarhorizontal,
scrollbarcorner {
    display: none;
    visibility: hidden;
    width: 0px;
    height: 0px;
    background-color: transparent;
    border-width: 0px;
}
#rr-panel {
    box-sizing: border-box;
    position: absolute;
    left: var(--rr-legacy-layout-003, 0px);
    top: var(--rr-legacy-layout-004, 0px);
    width: var(--rr-legacy-layout-005, 0px);
    height: var(--rr-legacy-layout-006, 0px);
    overflow-x: hidden;
    overflow-y: auto;
    padding: 14px;
    background-color: #0b1118;
    border-width: 1px;
    border-color: #4e6b80;
    border-radius: 8px;
}
#rr-scene-launch-control {
    position: fixed;
    z-index: 8;
    left: var(--rr-legacy-layout-007, 0px);
    top: var(--rr-legacy-layout-008, 0px);
    width: var(--rr-legacy-layout-009, 0px);
    height: var(--rr-legacy-layout-010, 0px);
    padding: 0px 16px;
    color: #edfdf4;
    background-color: #1d6e53;
    border-width: 1px;
    border-color: #7ae4ad;
    border-radius: 9px;
    font-size: 20px;
    font-weight: bold;
    text-align: center;
    text-transform: uppercase;
}
#rr-scene-launch-control:disabled {
    color: #9eafb4;
    background-color: #13252a;
    border-color: #34566a;
}
#rr-telemetry-chart-legend {
    position: fixed;
    z-index: 7;
    left: var(--rr-legacy-layout-011, 0px);
    top: var(--rr-legacy-layout-012, 0px);
    width: var(--rr-legacy-layout-013, 0px);
    height: var(--rr-legacy-layout-014, 0px);
    display: flex;
    flex-direction: row;
    gap: 6px;
    pointer-events: none;
}
.native-telemetry-legend-chip {
    box-sizing: border-box;
    flex: 1 1 0px;
    min-width: 0px;
    height: 24px;
    padding: 3px 4px;
    background-color: rgba(9, 16, 24, 0.82);
    border-width: 1px;
    border-color: rgba(137, 178, 211, 0.26);
    border-radius: 6px;
}
.native-telemetry-legend-chip .swatch {
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: 4px;
    vertical-align: middle;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    border-radius: 5px;
}
.native-telemetry-legend-chip strong {
    display: inline-block;
    color: #e7f5f8;
    font-size: 9px;
    line-height: 14px;
    vertical-align: middle;
    text-transform: uppercase;
}
.native-telemetry-legend-chip.warn {
    border-color: rgba(97, 220, 255, 0.40);
}
.native-telemetry-legend-chip.warn .swatch {
    background-color: #55d9ff;
}
.native-telemetry-legend-chip.heat {
    border-color: rgba(255, 196, 96, 0.40);
}
.native-telemetry-legend-chip.heat .swatch {
    background-color: #ffc45b;
}
.native-telemetry-legend-chip.threshold {
    border-color: rgba(255, 209, 102, 0.40);
}
.native-telemetry-legend-chip.threshold .swatch {
    height: 3px;
    margin-top: 4px;
    margin-bottom: 3px;
    background-color: #ffd166;
}
#rr-panel.title-screen-panel-mode {
    left: 0px;
    top: 0px;
    width: var(--rr-legacy-layout-005, 0px);
    height: var(--rr-legacy-layout-006, 0px);
    overflow: hidden;
    padding: 0px;
    background-color: transparent;
    border-width: 0px;
    border-radius: 0px;
}
#rr-panel.story-briefing-panel-mode {
    left: 0px;
    top: 0px;
    width: var(--rr-legacy-layout-005, 0px);
    height: var(--rr-legacy-layout-006, 0px);
    overflow: hidden;
    padding: 0px;
    background-color: transparent;
    border-width: 0px;
    border-radius: 0px;
}
#rr-panel.results-panel-mode {
    left: 0px;
    top: 0px;
    width: var(--rr-legacy-layout-001, 0px);
    height: var(--rr-legacy-layout-002, 0px);
    overflow: hidden;
    padding: 0px;
    background-color: transparent;
    border-width: 0px;
    border-radius: 0px;
}
#rr-panel.results-panel-mode > .panel-head,
#rr-panel.results-panel-mode > .rr-shell .rr-shell-content > .panel-head,
#rr-panel.results-panel-mode > .status,
#rr-panel.results-panel-mode > .rr-shell .rr-shell-content > .status,
#rr-panel.results-panel-mode > .panel-kpis,
#rr-panel.results-panel-mode > .rr-shell .rr-shell-content > .panel-kpis {
    display: none;
}
.story-briefing {
    position: relative;
    width: var(--rr-legacy-layout-005, 0px);
    height: var(--rr-legacy-layout-006, 0px);
    overflow: hidden;
    background-color: rgba(2, 7, 13, 0.46);
}
.story-vignette {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    background-color: rgba(2, 7, 13, 0.28);
}
.story-introduction .story-vignette {
    background-color: rgba(2, 7, 13, 0.12);
}
.story-content {
    box-sizing: border-box;
    position: absolute;
    left: var(--rr-legacy-layout-015, 0px);
    top: var(--rr-legacy-layout-016, 0px);
    width: var(--rr-legacy-layout-017, 0px);
    padding: 24px 30px;
    background-color: rgba(3, 12, 20, 0.88);
    border-left-width: 3px;
    border-color: #63e5ff;
}
.story-introduction .story-content {
    left: var(--rr-legacy-layout-018, 0px);
    top: var(--rr-legacy-layout-019, 0px);
    width: var(--rr-legacy-layout-020, 0px);
    padding: 24px 28px;
    background-color: rgba(3, 10, 17, 0.94);
}
body.controller-connected .story-introduction .story-content {
    width: var(--rr-legacy-layout-021, 0px);
}
.story-straylight .story-content { border-color: #ffd166; }
.story-kicker {
    display: block;
    color: #84dff2;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 2px;
}
.story-content h1 {
    margin-top: 8px;
    margin-bottom: 8px;
    color: #f4fbff;
    font-size: 54px;
    line-height: 1;
    letter-spacing: 3px;
}
.story-straylight .story-content h1 { color: #ffd166; font-effect: glow(2px #6f5519); }
.story-lead {
    width: 82%;
    color: #d7e9ef;
    font-size: 18px;
    line-height: 1.35;
}
.story-introduction .story-content h1 {
    margin-top: 9px;
    margin-bottom: 18px;
    color: #ffd166;
    font-size: 46px;
    line-height: 1;
    letter-spacing: 2px;
}
.story-exposition {
    width: 100%;
}
.story-exposition p {
    margin-top: 0px;
    margin-bottom: 13px;
    color: #d7e9ef;
    font-size: 16px;
    line-height: 1.45;
}
.story-exposition .story-directive {
    margin-top: 17px;
    margin-bottom: 0px;
    color: #fff0b7;
    font-weight: bold;
}
.story-introduction .story-action {
    width: 220px;
    margin-top: 18px;
}
.story-beats {
    display: flex;
    flex-direction: row;
    width: 100%;
    margin-top: 22px;
}
.story-beats article {
    box-sizing: border-box;
    width: 31%;
    min-height: 132px;
    margin-right: 2%;
    padding: 14px;
    background-color: rgba(8, 27, 39, 0.86);
    border-top-width: 1px;
    border-color: rgba(99, 229, 255, 0.38);
}
.story-beats article span { color: #63e5ff; font-size: 11px; font-weight: bold; }
.story-beats article h2 { margin-top: 5px; margin-bottom: 6px; color: #f1f8fa; font-size: 18px; }
.story-beats article p { color: #b9ced6; font-size: 13px; line-height: 1.35; }
.story-action {
    width: 280px;
    min-height: 48px;
    margin-top: 22px;
    font-size: 15px;
    font-weight: bold;
}
.opening-controls {
    box-sizing: border-box;
    position: absolute;
    right: var(--rr-legacy-layout-022, 0px);
    bottom: var(--rr-legacy-layout-023, 0px);
    display: flex;
    flex-direction: column;
    width: var(--rr-legacy-layout-024, 0px);
    padding: 12px 14px 14px;
    background-color: rgba(3, 12, 20, 0.90);
    border-left-width: 2px;
    border-color: rgba(99, 229, 255, 0.58);
}
.opening-controls-kicker {
    width: 100%;
    margin-bottom: 8px;
    color: #84dff2;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1px;
}
.opening-control-cards {
    display: flex;
    flex-direction: row;
    width: 100%;
}
.opening-control-card {
    box-sizing: border-box;
    width: 100%;
    min-height: 218px;
    margin-right: 2%;
    padding: 10px 12px;
    border-top-width: 1px;
    border-color: rgba(99, 229, 255, 0.38);
    background-color: rgba(8, 27, 39, 0.82);
}
.opening-control-title {
    display: block;
    color: #84dff2;
    font-size: 11px;
    font-weight: bold;
    text-transform: uppercase;
}
.opening-control-row {
    width: 100%;
    margin-top: 8px;
}
.opening-control-row > strong {
    color: #fff0b7;
    font-size: 10px;
    text-transform: uppercase;
}
.opening-control-row p {
    margin-top: 2px;
    margin-bottom: 0px;
    color: #c5d7de;
    font-size: 10px;
    line-height: 1.22;
}
.opening-control-row p strong { display: inline; color: #fff0b7; }
.opening-controller-controls { display: none; }
body.controller-connected .opening-keyboard-controls { width: 48%; }
body.controller-connected .opening-controller-controls { display: block; width: 48%; }
body.controller-connected .opening-controls { width: var(--rr-legacy-layout-025, 0px); }
.title-screen {
    position: relative;
    width: var(--rr-legacy-layout-005, 0px);
    height: var(--rr-legacy-layout-006, 0px);
    overflow: hidden;
}
.title-content {
    box-sizing: border-box;
    position: absolute;
    left: var(--rr-legacy-layout-026, 0px);
    top: var(--rr-legacy-layout-027, 0px);
    width: var(--rr-legacy-layout-028, 0px);
    min-height: var(--rr-legacy-layout-029, 0px);
    padding: var(--rr-legacy-layout-030, 0px);
    text-align: center;
    background-color: rgba(3, 10, 16, 0.76);
    border-width: 1px;
    border-color: rgba(71, 220, 255, 0.28);
    border-radius: 14px;
}
.title-kicker {
    width: 100%;
    color: rgba(163, 226, 239, 0.78);
    font-size: var(--rr-legacy-layout-031, 0px);
    font-weight: bold;
    line-height: 1.15;
    text-align: center;
    text-transform: uppercase;
}
.orebit-lockup {
    position: relative;
    left: var(--rr-legacy-layout-032, 0px);
    display: flex;
    flex-direction: row;
    width: var(--rr-legacy-layout-033, 0px);
    height: var(--rr-legacy-layout-034, 0px);
    margin-top: var(--rr-legacy-layout-035, 0px);
    margin-bottom: var(--rr-legacy-layout-036, 0px);
}
.orebit-letter {
    display: block;
    width: var(--rr-legacy-layout-037, 0px);
    color: #f4c95d;
    font-size: var(--rr-legacy-layout-038, 0px);
    font-weight: bold;
    line-height: 1;
    text-align: center;
    font-effect: glow(2px #9b761e);
    animation: orebit-letter-float 2.8s cubic-in-out infinite alternate;
}
.orebit-bit {
    color: #63e5ff;
    font-effect: glow(2px #155d78);
}
.orebit-letter-r { animation: 3.25s cubic-in-out infinite alternate orebit-letter-float; }
.orebit-letter-e { animation: 2.55s cubic-in-out infinite alternate orebit-letter-float; }
.orebit-letter-b { animation: 3.5s cubic-in-out infinite alternate orebit-letter-float; }
.orebit-letter-i { animation: 2.7s cubic-in-out infinite alternate orebit-letter-float; }
.orebit-letter-t { animation: 3.1s cubic-in-out infinite alternate orebit-letter-float; }
@keyframes orebit-letter-float {
    from {
        transform: translateY(-5px) rotate(-1.5deg);
        opacity: 0.88;
    }
    to {
        transform: translateY(6px) rotate(1.5deg);
        opacity: 1;
    }
}
.title-tagline {
    width: 100%;
    margin-top: 0px;
    color: #edf7fb;
    font-size: var(--rr-legacy-layout-039, 0px);
    font-weight: bold;
    line-height: 1.15;
    text-align: center;
    text-transform: uppercase;
}
.title-divider {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-top: var(--rr-legacy-layout-040, 0px);
    margin-bottom: var(--rr-legacy-layout-041, 0px);
}
.title-divider span {
    width: var(--rr-legacy-layout-042, 0px);
    height: 1px;
    background-color: rgba(71, 220, 255, 0.38);
}
.title-divider strong {
    width: 250px;
    color: rgba(244, 201, 93, 0.78);
    font-size: 10px;
    line-height: 1;
    text-align: center;
}
.title-menu {
    position: relative;
    left: var(--rr-legacy-layout-043, 0px);
    display: flex;
    flex-direction: column;
    width: var(--rr-legacy-layout-044, 0px);
}
.title-menu .title-action {
    width: var(--rr-legacy-layout-044, 0px);
    min-height: var(--rr-legacy-layout-045, 0px);
    height: auto;
    margin-top: 7px;
    padding: 8px 18px;
    color: #eaf7fb;
    font-size: var(--rr-legacy-layout-046, 0px);
    font-weight: bold;
    line-height: 1.1;
    text-transform: uppercase;
    background-color: rgba(8, 26, 36, 0.91);
    border-width: 1px;
    border-color: rgba(99, 229, 255, 0.42);
    border-radius: 6px;
}
.title-menu .title-action:hover,
body.controller-focus-visible .title-menu .title-action.rr-controller-focus {
    color: #ffffff;
    background-color: rgba(18, 59, 77, 0.96);
    border-color: #63e5ff;
}
.title-menu .title-continue {
    color: #fff0b7;
    background-color: rgba(60, 48, 17, 0.92);
    border-color: rgba(244, 201, 93, 0.68);
}
.title-menu .title-continue:hover,
body.controller-focus-visible .title-menu .title-continue.rr-controller-focus {
    background-color: rgba(92, 69, 19, 0.96);
    border-color: #f4c95d;
}
.title-save-state {
    width: 100%;
    margin-top: 12px;
    color: rgba(157, 177, 189, 0.72);
    font-size: 10px;
    font-weight: bold;
    line-height: 1;
    text-align: center;
}
.title-save-state.save-found { color: #7ce7b0; }
.title-notice {
    width: 100%;
    margin-top: 7px;
    color: #ffd166;
    font-size: 11px;
    line-height: 1.2;
    text-align: center;
}
.title-footer {
    width: 100%;
    margin-top: var(--rr-legacy-layout-047, 0px);
    color: rgba(127, 160, 176, 0.58);
    font-size: 10px;
    line-height: 1;
    text-align: center;
}
.title-scanline {
    position: absolute;
    left: 0px;
    width: var(--rr-legacy-layout-005, 0px);
    height: 1px;
    background-color: rgba(99, 229, 255, 0.18);
    animation: 7s linear 0s infinite orebit-scanline-sweep;
}
.title-scanline-a { top: 0px; }
.title-scanline-b {
    top: var(--rr-legacy-layout-048, 0px);
    animation: 10s linear infinite orebit-scanline-sweep;
    background-color: rgba(244, 201, 93, 0.14);
}
@keyframes orebit-scanline-sweep {
    from { transform: translateY(0px); opacity: 0; }
    12% { opacity: 1; }
    88% { opacity: 0.72; }
    to { transform: translateY(var(--rr-legacy-layout-006, 0px)); opacity: 0; }
}
#rr-modal.modal-new_game_confirm {
    left: var(--rr-legacy-layout-049, 0px);
    top: var(--rr-legacy-layout-050, 0px);
    width: var(--rr-legacy-layout-051, 0px);
    height: var(--rr-legacy-layout-052, 0px);
    margin-left: 0px;
    border-color: #a77f32;
}
#rr-panel.surface-ops-panel {
    overflow-x: hidden;
    overflow-y: auto;
}
#rr-panel.navigation-panel {
    overflow-x: hidden;
    overflow-y: auto;
}
#rr-panel.arrival-fanfare-panel-mode {
    box-sizing: border-box;
    overflow: hidden;
    padding: 10px;
    background-color: #0b101a;
    border-width: 1px;
    border-color: #8a7131;
    border-radius: 12px;
}
#rr-panel.arrival-fanfare-panel-mode > .panel-head,
#rr-panel.arrival-fanfare-panel-mode > .rr-shell .rr-shell-content > .panel-head,
#rr-panel.arrival-fanfare-panel-mode > .status,
#rr-panel.arrival-fanfare-panel-mode > .rr-shell .rr-shell-content > .status,
#rr-panel.arrival-fanfare-panel-mode > .panel-kpis,
#rr-panel.arrival-fanfare-panel-mode > .rr-shell .rr-shell-content > .panel-kpis {
    display: none;
}
.arrival-fanfare-panel {
    box-sizing: border-box;
    display: block;
    width: 100%;
    height: 100%;
    padding: 10px 8px;
    background-color: #0d1320;
    border-width: 1px;
    border-color: #31566b;
    border-radius: 9px;
}
.arrival-stamp-kicker {
    color: #ffd166;
    font-size: 13px;
    font-weight: bold;
    line-height: 1;
    text-transform: uppercase;
}
.arrival-stamp-title {
    width: 100%;
    margin-top: 7px;
    margin-bottom: 5px;
    color: #f8fbff;
    font-size: var(--rr-legacy-layout-053, 0px);
    line-height: 0.95;
    text-transform: uppercase;
}
.arrival-stamp-destination {
    color: #dceaf2;
    font-size: 15px;
    line-height: 1.15;
}
.arrival-stamp-tags {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    width: 100%;
    margin-top: 12px;
}
.arrival-stamp-tags span {
    min-height: 24px;
    margin-right: 7px;
    margin-bottom: 5px;
    padding: 5px 8px;
    color: #dff7ff;
    font-size: 13px;
    font-weight: bold;
    line-height: 1.1;
    background-color: #102835;
    border-width: 1px;
    border-color: #34566a;
    border-radius: 14px;
}
.arrival-stamp-tags span.gold {
    color: #ffe6a5;
    background-color: #332b15;
    border-color: #8a7131;
}
.arrival-stamp-continue {
    width: 320px;
    min-height: 28px;
    height: 28px;
    margin-top: 3px;
    margin-right: 0px;
    padding: 0px;
    color: #9eafbc;
    font-size: 13px;
    line-height: 28px;
    text-align: left;
    background-color: transparent;
    border-width: 0px;
}
#rr-panel.mining-fullscreen-panel {
    left: 0px;
    top: 0px;
    width: var(--rr-legacy-layout-005, 0px);
    height: var(--rr-legacy-layout-006, 0px);
    overflow: hidden;
    padding: 0px;
    background-color: transparent;
    border-width: 0px;
    border-radius: 0px;
}
#rr-panel.mining-fullscreen-panel .panel-head,
#rr-panel.mining-fullscreen-panel .status,
#rr-panel.mining-fullscreen-panel .panel-kpis {
    display: none;
}
.mining-fullscreen {
    position: relative;
    width: var(--rr-legacy-layout-005, 0px);
    height: var(--rr-legacy-layout-006, 0px);
}
.mining-top-rail,
.mining-bottom-rail,
.mining-failure-banner {
    position: absolute;
    border-width: 1px;
    border-color: rgba(71, 220, 255, 0.34);
    border-radius: 8px;
    background-color: rgba(5, 13, 18, 0.86);
}
.mining-top-rail {
    left: var(--rr-legacy-layout-054, 0px);
    top: var(--rr-legacy-layout-054, 0px);
    width: var(--rr-legacy-layout-055, 0px);
    min-height: var(--rr-legacy-layout-056, 0px);
    height: var(--rr-legacy-layout-056, 0px);
    padding: 0px;
    box-sizing: border-box;
    display: block;
}
.mining-cocoon-progress {
    position: absolute;
    left: var(--rr-legacy-layout-057, 0px);
    top: var(--rr-legacy-layout-058, 0px);
    width: 380px;
    min-height: 48px;
    padding: 6px 8px;
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    align-content: center;
    justify-content: flex-start;
    border-width: 1px;
    border-color: rgba(255, 129, 54, 0.66);
    border-radius: 6px;
    background-color: rgba(28, 10, 4, 0.90);
    z-index: 6;
}
.mining-cocoon-progress > div {
    width: 104px;
    margin-right: 8px;
}
.mining-cocoon-progress > div > span,
.mining-cocoon-progress > div > b {
    color: #ffc18b;
    font-size: 9px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.mining-cocoon-progress > div > section {
    width: 104px;
    display: flex;
    flex-direction: row;
    margin-top: 3px;
    margin-bottom: 2px;
}
.mining-cocoon-progress i {
    flex: 1 1 1px;
    max-width: 17px;
    height: 6px;
    margin-right: 3px;
    background-color: #8f2818;
}
.mining-cocoon-progress i.is-cleared {
    background-color: #aebcc2;
}
.mining-cocoon-progress > div.is-locked {
    opacity: 0.46;
}
.mining-cocoon-progress > strong {
    width: 132px;
    margin-left: auto;
    color: #fff0d8;
    font-size: 9px;
    line-height: 1.18;
    text-align: right;
}
.mining-run-title {
    display: none;
}
.mining-run-title span,
.mining-utility-cluster span,
.mining-command-dock span,
.mining-payload-strip > span {
    color: rgba(154, 230, 244, 0.80);
    font-size: 12px;
    text-transform: uppercase;
}
.mining-run-title strong {
    color: #f1fbff;
    font-size: 23px;
    line-height: 1.05;
}
.mining-run-title small,
.mining-run-title .mining-run-objective {
    color: rgba(215, 232, 234, 0.78);
    font-size: 12px;
    line-height: 1.12;
}
.mining-run-title.debug-arena strong {
    display: block;
    font-size: 14px;
}
.mining-run-title.debug-arena .mining-arena-metadata {
    font-size: 10px;
}
.mining-vitals {
    position: absolute;
    left: var(--rr-legacy-layout-059, 0px);
    top: 7px;
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    width: var(--rr-legacy-layout-060, 0px);
    margin-top: 0px;
    margin-right: 0px;
}
.mining-vitals .metric {
    width: var(--rr-legacy-layout-061, 0px);
    height: var(--rr-legacy-layout-062, 0px);
    min-height: var(--rr-legacy-layout-062, 0px);
    margin-right: var(--rr-legacy-layout-063, 0px);
    margin-bottom: 0px;
    padding: 3px 5px;
    box-sizing: border-box;
    background-color: rgba(8, 30, 39, 0.94);
    border-width: 1px;
    border-color: #2f7d99;
}
.mining-vitals .metric strong {
    font-size: 20px;
    line-height: 0.98;
}
.mining-vitals .metric span {
    font-size: 10px;
    line-height: 1.0;
}
.mining-vitals .metric.mining-alert-caution {
    border-color: #c8a446;
}
.mining-vitals .metric.mining-alert-caution strong,
.mining-vitals .metric.mining-alert-caution span {
    color: #ffe6a5;
}
.mining-vitals .metric.mining-alert-caution.mining-alert-pulse-1 {
    background-color: rgba(31, 38, 29, 0.92);
}
.mining-vitals .metric.mining-alert-caution.mining-alert-pulse-2 {
    background-color: rgba(42, 45, 29, 0.94);
}
.mining-vitals .metric.mining-alert-caution.mining-alert-pulse-3 {
    background-color: rgba(53, 53, 29, 0.96);
}
.mining-vitals .metric.mining-alert-critical {
    border-color: #c95d50;
}
.mining-vitals .metric.mining-alert-critical strong,
.mining-vitals .metric.mining-alert-critical span {
    color: #ffd8d3;
}
.mining-vitals .metric.mining-alert-critical.mining-alert-pulse-1 {
    background-color: rgba(37, 27, 30, 0.92);
}
.mining-vitals .metric.mining-alert-critical.mining-alert-pulse-2 {
    background-color: rgba(50, 30, 32, 0.94);
}
.mining-vitals .metric.mining-alert-critical.mining-alert-pulse-3 {
    background-color: rgba(64, 34, 35, 0.96);
}
.mining-vitals .metric.mining-vital-broken strong {
    color: #b8322b;
    font-weight: bold;
    text-transform: uppercase;
}
.mining-vitals .metric.mining-vital-broken.mining-alert-pulse-1 strong {
    color: #d94439;
}
.mining-vitals .metric.mining-vital-broken.mining-alert-pulse-2 strong {
    color: #f45b4d;
}
.mining-vitals .metric.mining-vital-broken.mining-alert-pulse-3 strong {
    color: #ff8278;
}
.mining-health-strip {
    width: var(--rr-legacy-layout-064, 0px);
    margin-top: 2px;
}
.mining-health-strip > div {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
}
.mining-health-strip span {
    color: rgba(169, 231, 246, 0.88);
    font-size: 12px;
    text-transform: uppercase;
}
.mining-health-strip strong {
    color: #e7fbff;
    font-size: 17px;
}
.mining-health-bar {
    width: var(--rr-legacy-layout-065, 0px);
    height: 9px;
    margin-top: 0px;
    background-color: rgba(1, 8, 13, 0.92);
    border-width: 1px;
    border-color: rgba(127, 236, 255, 0.18);
}
.mining-health-bar i {
    display: block;
    height: 9px;
    background-color: #4be7ff;
}
.mining-health-bar .health-fill-0 { width: 0px; }
.mining-health-bar .health-fill-10 { width: var(--rr-legacy-layout-066, 0px); }
.mining-health-bar .health-fill-20 { width: var(--rr-legacy-layout-067, 0px); }
.mining-health-bar .health-fill-30 { width: var(--rr-legacy-layout-068, 0px); }
.mining-health-bar .health-fill-40 { width: var(--rr-legacy-layout-069, 0px); }
.mining-health-bar .health-fill-50 { width: var(--rr-legacy-layout-070, 0px); }
.mining-health-bar .health-fill-60 { width: var(--rr-legacy-layout-071, 0px); }
.mining-health-bar .health-fill-70 { width: var(--rr-legacy-layout-072, 0px); }
.mining-health-bar .health-fill-80 { width: var(--rr-legacy-layout-073, 0px); }
.mining-health-bar .health-fill-90 { width: var(--rr-legacy-layout-074, 0px); }
.mining-health-bar .health-fill-100 { width: var(--rr-legacy-layout-065, 0px); }
.mining-utility-cluster {
    position: absolute;
    right: 8px;
    top: 12px;
    width: var(--rr-legacy-layout-075, 0px);
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: flex-end;
}
.mining-utility-cluster > span {
    display: none;
}
.mining-utility-cluster button {
    width: var(--rr-legacy-layout-076, 0px);
    min-height: 34px;
    height: auto;
    line-height: 1.15;
    margin-left: 4px;
    margin-bottom: 0px;
    padding: 4px 4px;
    font-size: 11px;
}
.mining-playfield-space {
    position: absolute;
    left: var(--rr-legacy-layout-077, 0px);
    top: var(--rr-legacy-layout-078, 0px);
    width: var(--rr-legacy-layout-079, 0px);
    height: var(--rr-legacy-layout-080, 0px);
}
.mining-depth-route-overlay {
    position: absolute;
    left: var(--rr-legacy-layout-077, 0px);
    top: var(--rr-legacy-layout-081, 0px);
    width: var(--rr-legacy-layout-079, 0px);
    height: var(--rr-legacy-layout-080, 0px);
    pointer-events: none;
}
.mining-depth-route-overlay span {
    display: block;
    position: absolute;
    left: var(--rr-legacy-layout-082, 0px);
    width: 240px;
    height: 22px;
    padding: 5px 8px;
    box-sizing: border-box;
    color: #21d8ef;
    font-size: 9px;
    font-weight: normal;
    line-height: 1.0;
    text-align: center;
    background-color: #030c12;
    border-width: 1px;
    border-color: #34596a;
    border-radius: 3px;
}
.mining-depth-route-overlay .mining-route-up { top: 8px; }
.mining-depth-route-overlay.is-cocoon .mining-route-up { top: var(--rr-cocoon-route-top, 60px); }
.mining-depth-route-overlay .mining-route-down { top: var(--rr-legacy-layout-083, 0px); }
.mining-bottom-rail {
    left: var(--rr-legacy-layout-054, 0px);
    top: var(--rr-legacy-layout-084, 0px);
    width: var(--rr-legacy-layout-055, 0px);
    min-height: var(--rr-legacy-layout-085, 0px);
    height: var(--rr-legacy-layout-085, 0px);
    padding: 8px 10px 28px 10px;
    box-sizing: border-box;
    display: block;
}
.mining-payload-strip {
    width: var(--rr-legacy-layout-086, 0px);
    margin-right: 12px;
}
.mining-payload-strip .stat-grid,
.mining-artifact-strip .stat-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
}
.mining-payload-strip .stat-chip,
.mining-artifact-strip .stat-chip {
    width: 112px;
    min-height: 16px;
    padding: 3px 5px;
    margin-top: 3px;
    margin-right: 6px;
    font-size: 11px;
}
.mining-artifact-strip {
    display: none;
}
.mining-command-dock {
    position: absolute;
    left: var(--rr-legacy-layout-087, 0px);
    top: 10px;
    width: var(--rr-legacy-layout-088, 0px);
}
.mining-command-dock strong {
    color: #f1fbff;
    font-size: 17px;
    margin-bottom: 6px;
}
.mining-command-list {
    display: flex;
    flex-direction: column;
    margin-top: 3px;
    margin-bottom: 8px;
}
.mining-command-list span {
    display: block;
    color: #f1fbff;
    font-size: 13px;
    line-height: 1.2;
    margin-bottom: 4px;
    text-transform: none;
}
.mining-command-dock .system-actions {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
}
.mining-command-dock .system-actions button {
    width: var(--rr-legacy-layout-089, 0px);
    min-height: 36px;
    height: auto;
    line-height: 1.15;
    margin-right: 8px;
    margin-bottom: 4px;
    padding: 5px 4px;
    font-size: 12px;
}
.mining-ship-service-marker {
    display: none;
}
.mining-recall-dock {
    position: absolute;
    left: var(--rr-legacy-layout-090, 0px);
    top: var(--rr-legacy-layout-091, 0px);
    width: var(--rr-legacy-layout-092, 0px);
}
.mining-recall-dock .system-actions button {
    width: var(--rr-legacy-layout-092, 0px);
    min-height: 34px;
    height: auto;
    line-height: 1.15;
    padding: 5px 4px;
    font-size: 12px;
}
.mining-failure-banner {
    left: var(--rr-legacy-layout-054, 0px);
    top: var(--rr-legacy-layout-078, 0px);
    width: var(--rr-legacy-layout-093, 0px);
    padding: 10px;
    border-color: rgba(255, 95, 87, 0.52);
    background-color: rgba(42, 10, 13, 0.90);
}
.mining-failure-banner strong {
    color: #ffe1df;
    font-size: 17px;
}
.mining-failure-banner span {
    color: rgba(255, 226, 222, 0.82);
    font-size: 12px;
    line-height: 1.22;
}
.phase-lane,
.phase-title-row,
.phase-footer-lane {
    width: var(--rr-legacy-layout-094, 0px);
    margin-left: var(--rr-legacy-layout-095, 0px);
    margin-right: var(--rr-legacy-layout-095, 0px);
}
.objective-strip {
    display: block;
    padding: 10px 12px;
    margin-bottom: 10px;
    border-width: 1px;
    border-color: rgba(255, 209, 102, 0.52);
    background-color: rgba(34, 29, 13, 0.90);
}
.objective-strip span { color: #ffd166; font-size: 11px; }
.objective-strip strong { display: block; color: #fff2c0; font-size: 14px; }
.objective-strip p { margin: 3px 0 0 0; color: rgba(255, 244, 205, 0.78); font-size: 11px; }
.campaign-objective {
    box-sizing: border-box;
    padding: 8px 11px;
}
.campaign-objective-head,
.campaign-objective-foot,
.campaign-progress {
    display: flex;
    flex-direction: row;
    align-items: center;
}
.campaign-objective-head,
.campaign-objective-foot {
    justify-content: space-between;
}
.campaign-objective-head em {
    padding: 2px 6px;
    border-width: 1px;
    border-color: rgba(255, 209, 102, 0.58);
    color: #ffd166;
    font-size: 9px;
    font-style: normal;
}
.campaign-objective > strong {
    margin-top: 3px;
}
.campaign-progress {
    margin-top: 5px;
}
.campaign-progress i {
    width: 24px;
    height: 6px;
    margin-right: 4px;
    background-color: rgba(119, 136, 142, 0.34);
}
.campaign-progress i.is-filled {
    background-color: #63e5ff;
}
.campaign-progress b {
    margin-left: 4px;
    color: #dff8ff;
    font-size: 10px;
}
.campaign-objective-foot {
    margin-top: 6px;
}
.campaign-objective-foot small {
    color: #9fd2dd;
    font-size: 9px;
}
.campaign-objective-foot button {
    min-height: 28px;
    padding: 4px 9px;
