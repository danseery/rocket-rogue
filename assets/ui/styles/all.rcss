}
#rr-document.rr-bottom-dock #rr-panel.selection-family-panel .draft-actions button{
    width: 180px;
    min-height: 34px;
    height: auto;
    margin-bottom: 5px;
}


/* Final compact-family reset. These rules intentionally outrank the old
   704 px phase-board cards so a rail never inherits desktop card heights. */
#rr-panel.management-family-panel > .panel-head,
#rr-panel.management-family-panel > .rr-shell .rr-shell-content > .panel-head,
#rr-panel.decision-family-panel > .panel-head,
#rr-panel.decision-family-panel > .rr-shell .rr-shell-content > .panel-head,
#rr-panel.live-hud-family-panel > .panel-head,
#rr-panel.live-hud-family-panel > .rr-shell .rr-shell-content > .panel-head,
#rr-panel.selection-family-panel > .panel-head,
#rr-panel.selection-family-panel > .rr-shell .rr-shell-content > .panel-head {
    margin-bottom: 8px;
}
#rr-panel.management-family-panel > .status.panel-objective,
#rr-panel.management-family-panel > .rr-shell .rr-shell-content > .status.panel-objective,
#rr-panel.decision-family-panel > .status.panel-objective,
#rr-panel.decision-family-panel > .rr-shell .rr-shell-content > .status.panel-objective {
    display: block;
    min-height: 0px;
