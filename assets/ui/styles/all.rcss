/* Shared fixed-action workspaces supersede the staged workspace rule that
   otherwise returns every phase board to content-sized scrolling. Keep this
   selector component-based so future decision screens can consume the same
   geometry without a screen-local override. */
#rr-panel.workspace-panel .rr-fixed-action-stack {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: var(--rr-workspace-action-stack-height);
    min-height: 280px;
    max-height: var(--rr-workspace-action-stack-height);
    padding-bottom: 0px;
    overflow: hidden;
}
#rr-panel.workspace-panel .rr-fixed-action-context {
    display: block;
    flex: 1 1 auto;
    width: 100%;
    min-height: 0px;
    overflow-x: hidden;
    overflow-y: auto;
}
#rr-panel.workspace-panel .rr-fixed-action-lane {
    display: flex;
    flex: 0 0 auto;
    width: 100%;
    min-height: 0px;
    margin: 8px 0px 0px 0px;
    overflow: hidden;
}

/* Surface Ops is a short top-to-bottom decision sequence, not a persistent
   bottom dock: show the expedition choices directly after Drone Ops. */
#rr-panel.workspace-panel .surface-ops-screen.rr-fixed-action-stack .rr-fixed-action-context {
    flex: 0 0 auto;
    overflow-y: visible;
}
#rr-panel.workspace-panel .surface-ops-screen.rr-fixed-action-stack .rr-fixed-action-lane {
    margin-top: 10px;
}

/* Keep Drone Ops readable without making the Steam Deck side rail scroll. */
#rr-panel.drone-workspace-panel .drone-control-card {
    min-height: 188px;
    height: 188px;
    max-height: 188px;
    padding: 7px;
}
#rr-panel.drone-workspace-panel .drone-control-card .drone-card-head {
    margin-bottom: 2px;
}
