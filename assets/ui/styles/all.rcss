}
#rr-document.rr-bottom-dock #rr-panel.management-family-panel .phase-titlebar,
#rr-document.rr-bottom-dock #rr-panel.decision-family-panel .phase-titlebar,
#rr-document.rr-bottom-dock #rr-panel.management-family-panel .phase-advisory,
#rr-document.rr-bottom-dock #rr-panel.management-family-panel .focus-metrics,
#rr-document.rr-bottom-dock #rr-panel.management-family-panel .section-heading,
#rr-document.rr-bottom-dock #rr-panel.management-family-panel .drone-top-row,
#rr-document.rr-bottom-dock #rr-panel.selection-family-panel .draft-hero,
#rr-document.rr-bottom-dock #rr-panel.selection-family-panel .draft-recovery-note,
#rr-document.rr-bottom-dock #rr-panel.selection-family-panel .draft-board > .phase-titlebar,
#rr-document.rr-bottom-dock #rr-panel.hangar-family-panel .phase-board-hangar > h2,
#rr-document.rr-bottom-dock #rr-panel.hangar-family-panel .objective-strip,
#rr-document.rr-bottom-dock #rr-panel.hangar-family-panel .hangar-detail-actions{
