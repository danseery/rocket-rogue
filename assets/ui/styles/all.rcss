#rr-document.rr-bottom-dock #rr-panel.drone-family-panel .drone-control-grid,
#rr-document.rr-bottom-dock #rr-panel.drone-family-panel .drone-loadout-grid{
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    width: auto;
    min-width: 610px;
