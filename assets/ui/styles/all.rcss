    padding: 0px;
    color: #f1b72b;
    font-size: 11px;
    line-height: 1.2;
}
#rr-panel.management-family-panel > .panel-kpis,
#rr-panel.management-family-panel > .rr-shell .rr-shell-content > .panel-kpis,
#rr-panel.decision-family-panel > .panel-kpis,
#rr-panel.decision-family-panel > .rr-shell .rr-shell-content > .panel-kpis {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    width: 100%;
    margin: 0px 0px 10px 0px;
}
#rr-panel.management-family-panel > .panel-kpis .metric,
#rr-panel.management-family-panel > .rr-shell .rr-shell-content > .panel-kpis .metric,
#rr-panel.decision-family-panel > .panel-kpis .metric,
#rr-panel.decision-family-panel > .rr-shell .rr-shell-content > .panel-kpis .metric {
    flex: 1 1 0px;
    width: auto;
    min-width: 0px;
    min-height: 54px;
    height: 54px;
    margin: 0px 6px 0px 0px;
    padding: 6px 4px;
    overflow: hidden;
    text-align: center;
