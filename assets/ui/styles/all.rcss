}
#rr-panel.drone-workspace-panel .drone-control-card .drone-card-summary {
    min-height: 52px;
    max-height: 52px;
    margin: 2px 0px 4px 0px;
    line-height: 1.1;
}
#rr-panel.drone-workspace-panel .drone-control-card .card-footer {
