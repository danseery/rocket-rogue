#rr-document.rr-bottom-dock #rr-panel.management-family-panel > .status,
#rr-document.rr-bottom-dock #rr-panel.management-family-panel > .rr-shell .rr-shell-content > .status,
#rr-document.rr-bottom-dock #rr-panel.decision-family-panel > .status,
#rr-document.rr-bottom-dock #rr-panel.decision-family-panel > .rr-shell .rr-shell-content > .status{
