}
#rr-modal.modal-map {
    left: var(--rr-legacy-layout-111, 0px);
    top: var(--rr-legacy-layout-106, 0px);
    width: var(--rr-legacy-layout-112, 0px);
    height: var(--rr-legacy-layout-108, 0px);
    margin-left: 0px;
    padding: 16px;
}
#rr-modal.modal-surface {
    top: var(--rr-legacy-layout-106, 0px);
    height: var(--rr-legacy-layout-108, 0px);
    padding: 20px;
}
#rr-modal.modal-mission_log {
    top: var(--rr-legacy-layout-113, 0px);
    height: var(--rr-legacy-layout-114, 0px);
    padding: 20px;
}
#rr-modal.modal-launch_outcome {
    box-sizing: border-box;
