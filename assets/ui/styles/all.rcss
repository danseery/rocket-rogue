#rr-document.rr-bottom-dock #rr-panel.management-family-panel > .panel-kpis,
#rr-document.rr-bottom-dock #rr-panel.management-family-panel > .rr-shell .rr-shell-content > .panel-kpis,
#rr-document.rr-bottom-dock #rr-panel.decision-family-panel > .panel-kpis,
#rr-document.rr-bottom-dock #rr-panel.decision-family-panel > .rr-shell .rr-shell-content > .panel-kpis{
    position: absolute;
    left: 212px;
    right: 312px;
    top: 5px;
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    width: auto;
    height: 36px;
    margin: 0px;
    overflow: hidden;
}
#rr-document.rr-bottom-dock #rr-panel.management-family-panel > .panel-kpis .metric,
#rr-document.rr-bottom-dock #rr-panel.management-family-panel > .rr-shell .rr-shell-content > .panel-kpis .metric,
#rr-document.rr-bottom-dock #rr-panel.decision-family-panel > .panel-kpis .metric,
#rr-document.rr-bottom-dock #rr-panel.decision-family-panel > .rr-shell .rr-shell-content > .panel-kpis .metric{
    flex: 1 1 0px;
    width: auto;
    min-width: 0px;
    min-height: 36px;
    height: 36px;
    margin-right: 4px;
    padding: 4px;
}
#rr-document.rr-bottom-dock #rr-panel.management-family-panel > .phase-board,
#rr-document.rr-bottom-dock #rr-panel.management-family-panel > .rr-shell .rr-shell-content > .phase-board,
#rr-document.rr-bottom-dock #rr-panel.decision-family-panel > .phase-board,
#rr-document.rr-bottom-dock #rr-panel.decision-family-panel > .rr-shell .rr-shell-content > .phase-board,
#rr-document.rr-bottom-dock #rr-panel.selection-family-panel > .phase-board,
#rr-document.rr-bottom-dock #rr-panel.selection-family-panel > .rr-shell .rr-shell-content > .phase-board{
    position: absolute;
    left: 14px;
    right: 14px;
    top: 49px;
    bottom: 7px;
    width: auto;
